# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase.
# Painel do Supabase > Project Settings > API
#
# A chave "anon" e publica por natureza: ela vai no navegador de qualquer forma.
# A protecao real dos dados esta nas policies de RLS (supabase/migrations/0001_init.sql).
# NUNCA coloque aqui a chave "service_role".

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-aqui
